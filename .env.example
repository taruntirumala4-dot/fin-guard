# ============================================================
# FinGuard – Environment Variables
# Copy this file to .env and update values before running.
# NEVER commit the real .env file.
# ============================================================

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=finguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis ───────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Apache Kafka ─────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_TRANSACTIONS=transactions
KAFKA_TOPIC_FRAUD_ALERTS=fraud-alerts

# ─── ML Service ───────────────────────────────────────────────
ML_SERVICE_URL=http://ml-service:8000

# ─── JWT ──────────────────────────────────────────────────────
# Use a strong random secret in production (min 256-bit)
JWT_SECRET=change_me_to_a_very_long_random_secret_string_at_least_256_bits
JWT_EXPIRATION_MS=86400000

# ─── Spring Boot ──────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

# ─── Frontend ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080

# ─── AWS (for cloud deployment – not required locally) ────────
AWS_REGION=ap-south-1
AWS_S3_BUCKET=finguard-assets
